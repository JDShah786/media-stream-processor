# Server Configuration
PORT=3000
NODE_ENV=development

# File Paths
OUTPUT_DIR=./downloads
TEMP_DIR=./temp
LOGS_DIR=./logs

# yt-dlp Configuration
YTDLP_PATH=yt-dlp
MAX_VIDEO_DURATION=3600

# FFmpeg Configuration
FFMPEG_PATH=ffmpeg
AUDIO_BITRATE=192

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
