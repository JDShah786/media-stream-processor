{
  "name": "media-stream-converter",
  "version": "1.0.1",
  "description": "High-performance desktop application for extracting and converting public media streams to streamline content creation workflows",
  "main": "src/main.js",
  "homepage": "./",
  "author": "JD",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "server": "node src/server.js",
    "test": "jest",
    "build": "electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.8.3",
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^24.6.4",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  },
  "build": {
    "appId": "com.converto.app",
    "productName": "Converto",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/ui/assets/decor/Tiny Swords (Free Pack)/**",
      "!**/bin/_ffmpeg.zip"
    ],
    "win": {
      "icon": "src/ui/assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Converto"
    },
    "publish": {
      "provider": "github",
      "owner": "JDShah786",
      "repo": "media-stream-processor",
      "releaseType": "release"
    }
  }
}
